DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
GEMINI_API_KEY=

# Comma-separated browser origins allowed to send credentialed requests.
# localhost:5173 is always allowed; add the deployed frontend here, e.g.
# https://launchup-enhanced.vercel.app. Vercel preview URLs are unique per
# deployment, so client-side calls only work on origins listed here.
FRONTEND_ORIGINS=

# --- Object storage (S3-compatible) ---
# Read by UploadService (backend/src/upload/upload.service.ts). If any of the
# five are missing the service logs a warning, sets enabled = false, and every
# upload route returns 503 — the app still boots.
#
# Currently targeting Supabase Storage (S3-compatible, no card required). From
# the Supabase dashboard: Storage -> create a bucket, then Project Settings ->
# Storage for the S3 endpoint and region, and Storage -> S3 Access Keys for the
# key pair. Any S3-compatible provider works — only these values change.
#
# Keep the bucket PRIVATE. Nothing is publicly addressable; reads go through a
# signed GET minted by GET /upload/signed-url. Also set the bucket's max file
# size in the provider console: the presigned PUT cannot enforce length, so the
# bucket limit is the real backstop (the app's own cap is 10MB).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=          # e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_BUCKET=
S3_REGION=

# Days to keep OCR documents that never got attached to a startup. Parsing runs
# before a startup exists, so every row starts unattached and retries leave
# orphans behind. Pruned once per boot; 0 disables pruning entirely.
OCR_RETENTION_DAYS=30

# --- AI pipeline configuration ---
# Resolved by AiConfigService (backend/src/ai/ai-config.service.ts) into an
# AiPipelineConfig for every AI generation call. The four AI_*_ENABLED flags
# default to true, reproducing the pre-instrumentation behaviour; GEMINI_MODEL
# and AI_TEMPERATURE are not booleans and fall back to 'gemini-3.6-flash' and 0
# respectively when unset. Set a flag to false to run that arm of the
# baseline-vs-enhanced comparison.
#
# Model choice, measured against a free-tier key on 2026-07-27:
#   gemini-3.6-flash       ~780 thinking tokens, stays on-topic   <- default
#   gemini-3.5-flash       ~965 thinking tokens, ~2x slower
#   gemini-3.5-flash-lite  0 thinking tokens, cheap escape hatch
#   gemini-2.5-flash-lite  0 thinking tokens, answers off-dimension
#   gemini-2.5-flash       404 - "no longer available to new users"
#   any *-pro model        429 - not reachable on the free tier
# The lite tiers do no reasoning at all, which is what Objectives 1 and 4
# (hallucination, leniency bias) are about. 3.6-flash costs ~2.8x the tokens
# and ~3x the latency of 2.5-flash-lite; if quota bites, drop to
# gemini-3.5-flash-lite, which still beats 2.5-flash-lite on every axis.
GEMINI_MODEL=gemini-3.6-flash
AI_TEMPERATURE=0
AI_GROUNDING_ENABLED=true              # Objective 1a - grounded prompt wrapper
# Objective 1b, master retrieval switch for RagQueryService.queryVectorDatabase
# (rna/rag-query.service.ts) — RNA and RNS generation's *peer-startup* channel.
# AI_RAG_ENABLED=false is the "no retrieval" baseline arm: it disables peer
# retrieval outright. It does NOT reach the verified-knowledge corpus (rubrics
# / business frameworks) — that is AI_RAG_CORPUS_ENABLED below, a separate
# switch, because "does peer retrieval help" and "does the verified corpus
# help" are different arms of the comparison. Path 1 (AiService.
# getRelevantRagContexts, used by createBasePrompt's own ragBlock and by
# initiatives/roadblocks) also honours this flag independently.
AI_RAG_ENABLED=true                    # Objective 1b - retrieved context block
# How retrieval finds context when AI_RAG_ENABLED is true. Three arms, not two:
# AI_RAG_ENABLED=false answers "does retrieval help at all", while this answers
# "does semantic retrieval beat the token-overlap matching that was already
# here". An unknown value is rejected at boot rather than defaulted, so a typo
# cannot silently mislabel which arm a batch of generations ran under.
#   keyword  - token overlap (the pre-existing behaviour; baseline arm)
#   semantic - pgvector nearest neighbours over embedded contexts
AI_RAG_STRATEGY=semantic
# Objective 1b corpus. AI_RAG_STRATEGY above selects how *peer startups* are
# found (gated by AI_RAG_ENABLED, not this); these two govern the
# verified-knowledge corpus (readiness rubrics and business frameworks) seeded
# by `node seed-rag-corpus.js` — a channel independent of peer retrieval, so it
# has its own on/off switch rather than reusing AI_RAG_ENABLED's.
#
# AI_RAG_CORPUS_ENABLED=false disables the rubric and framework channels without
# deleting rows, which is how the corpus-on/corpus-off measurement arms are run.
AI_RAG_CORPUS_ENABLED=true
# How the rubric channel retrieves. deterministic is the default because an
# exact (dimension, level) lookup cannot return the wrong dimension and cannot
# silently fall below the similarity floor. `semantic` below is NOT SDD §3.2's
# specified mechanism ("queries the vector database using the startup's
# profile data as the search embedding") — it is the code's own substitute,
# embedding the bare dimension name (e.g. "Technology") instead. Measured
# (measurement/README.md, 2026-07-28) at 0/12 correct-dimension against this
# corpus; the SDD's actual profile-embedding mechanism, tested separately,
# also retrieved nothing (0/2). Both modes are kept anyway so the deviation
# from the SDD is measured rather than asserted — do not treat `semantic` as
# an equally-good option without reading that measurement first.
#   deterministic - exact key lookup (default)
#   semantic      - the code's substitute: pgvector nearest neighbours over
#                   the bare dimension name, gated by RAG_MIN_SIMILARITY.
#                   Measured to retrieve nothing (0/12) against this corpus.
AI_RAG_RUBRIC_MODE=deterministic
AI_BIAS_REVIEW_ENABLED=true            # Objective 4b - model bias review
AI_SCORE_NORMALIZATION_ENABLED=true    # Objective 4c - baseline normalization
# SO 4.2 - adversarial pre-analysis before the readiness summary.
# false restores the pre-2026-08-11 free-text prompt exactly.
AI_ADVERSARIAL_SUMMARY_ENABLED=true
#
# Embedding model backing RAG retrieval, resolved by EmbeddingService. Separate
# from GEMINI_MODEL: that one generates text, this one only produces vectors.
# Measured on 2026-07-27 — gemini-embedding-2 separates a relevant from an
# irrelevant document by a wider margin than gemini-embedding-001 (0.082 vs
# 0.070 at 768 dims) and, unlike -001, stays unit-normalised when truncated to
# 768 (-001 comes back at norm 0.59). Vectors are always stored at 768
# dimensions; that is a code constant, not a setting, because pgvector cannot
# ANN-index anything wider than 2000 (see EMBEDDING_DIMENSIONS).
AI_EMBEDDING_MODEL=gemini-embedding-2
# Allows Manager/Admin callers to override the above per request via the
# X-Ai-Pipeline-Config header. Defaults to false; keep false outside a
# research environment.
AI_ALLOW_REQUEST_OVERRIDE=false