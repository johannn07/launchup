DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

JWT_SECRET=
GEMINI_API_KEY=

# --- Object storage (S3-compatible) ---
# Read by UploadService (backend/src/upload/upload.service.ts). If any of the
# five are missing the service logs a warning, sets enabled = false, and every
# upload route returns 503 — the app still boots.
#
# Currently targeting Supabase Storage (S3-compatible, no card required). From
# the Supabase dashboard: Storage -> create a bucket, then Project Settings ->
# Storage for the S3 endpoint and region, and Storage -> S3 Access Keys for the
# key pair. Any S3-compatible provider works — only these values change.
#
# Keep the bucket PRIVATE. Nothing is publicly addressable; reads go through a
# signed GET minted by GET /upload/signed-url. Also set the bucket's max file
# size in the provider console: the presigned PUT cannot enforce length, so the
# bucket limit is the real backstop (the app's own cap is 10MB).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=          # e.g. https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_BUCKET=
S3_REGION=

# --- AI pipeline configuration ---
# Resolved by AiConfigService (backend/src/ai/ai-config.service.ts) into an
# AiPipelineConfig for every AI generation call. The four AI_*_ENABLED flags
# default to true, reproducing the pre-instrumentation behaviour; GEMINI_MODEL
# and AI_TEMPERATURE are not booleans and fall back to 'gemini-3.6-flash' and 0
# respectively when unset. Set a flag to false to run that arm of the
# baseline-vs-enhanced comparison.
#
# Model choice, measured against a free-tier key on 2026-07-27:
#   gemini-3.6-flash       ~780 thinking tokens, stays on-topic   <- default
#   gemini-3.5-flash       ~965 thinking tokens, ~2x slower
#   gemini-3.5-flash-lite  0 thinking tokens, cheap escape hatch
#   gemini-2.5-flash-lite  0 thinking tokens, answers off-dimension
#   gemini-2.5-flash       404 - "no longer available to new users"
#   any *-pro model        429 - not reachable on the free tier
# The lite tiers do no reasoning at all, which is what Objectives 1 and 4
# (hallucination, leniency bias) are about. 3.6-flash costs ~2.8x the tokens
# and ~3x the latency of 2.5-flash-lite; if quota bites, drop to
# gemini-3.5-flash-lite, which still beats 2.5-flash-lite on every axis.
GEMINI_MODEL=gemini-3.6-flash
AI_TEMPERATURE=0
AI_GROUNDING_ENABLED=true              # Objective 1a - grounded prompt wrapper
AI_RAG_ENABLED=true                    # Objective 1b - retrieved context block
AI_BIAS_REVIEW_ENABLED=true            # Objective 4b - model bias review
AI_SCORE_NORMALIZATION_ENABLED=true    # Objective 4c - baseline normalization
#
# Embedding model backing RAG retrieval, resolved by EmbeddingService. Separate
# from GEMINI_MODEL: that one generates text, this one only produces vectors.
# Measured on 2026-07-27 — gemini-embedding-2 separates a relevant from an
# irrelevant document by a wider margin than gemini-embedding-001 (0.082 vs
# 0.070 at 768 dims) and, unlike -001, stays unit-normalised when truncated to
# 768 (-001 comes back at norm 0.59). Vectors are always stored at 768
# dimensions; that is a code constant, not a setting, because pgvector cannot
# ANN-index anything wider than 2000 (see EMBEDDING_DIMENSIONS).
AI_EMBEDDING_MODEL=gemini-embedding-2
# Allows Manager/Admin callers to override the above per request via the
# X-Ai-Pipeline-Config header. Defaults to false; keep false outside a
# research environment.
AI_ALLOW_REQUEST_OVERRIDE=false